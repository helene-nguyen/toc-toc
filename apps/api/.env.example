# Copy to .env — variables for the API process (values must match the root .env)

#REQUIRED INFO SERVER
PORT=4210
# where Google sends people back after sign-in: the web app (Vite dev server)
APP_URL=http://localhost:5173

#REQUIRED INFO CONNEXION DB FOR PSQL
# 127.0.0.1 rather than localhost: Node may resolve localhost to IPv6 (::1), where Docker's Postgres is not always published
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=toctoc
POSTGRES_USER=toctoc
POSTGRES_PASSWORD=toctoc
POSTGRES_PORT=5436

#REQUIRED INFO AUTH
# generate a real one: openssl rand -hex 32
JWT_SECRET=change-me
# optional: only these emails may open an account (comma-separated); unset = anyone
ALLOWED_EMAILS=

#OPTIONAL INFO GOOGLE SIGN-IN
# create at console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
# authorized redirect URI: ${APP_URL}/api/v1/auth/google/callback (dev: http://localhost:5173/api/v1/auth/google/callback)
# leave unset to disable Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
