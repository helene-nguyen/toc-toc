# Copy to .env at the repo root — docker compose reads this file

#REQUIRED INFO CONNEXION DB FOR PSQL
POSTGRES_DB=toctoc
POSTGRES_USER=toctoc
POSTGRES_PASSWORD=change-me
# dev only: the port the local database is published on
POSTGRES_PORT=5445

#REQUIRED INFO APP (production, docker-compose.prod.yml)
# published on 127.0.0.1 only — reach it through `tailscale serve` (see README)
APP_PORT=4210
# image to run; build it on the Pi instead with `docker compose -f docker-compose.prod.yml build`
APP_IMAGE=ghcr.io/helene-nguyen/toc-toc:latest

#REQUIRED INFO AUTH (production)
# signs the session cookies — generate one: openssl rand -hex 32
JWT_SECRET=change-me
# the address people open: the Tailscale one, e.g. https://raspberrypi.tail1234.ts.net
APP_URL=
# optional: only these emails may open an account (comma-separated); empty = anyone who reaches the app
ALLOWED_EMAILS=

#OPTIONAL INFO GOOGLE SIGN-IN (production)
# OAuth client at console.cloud.google.com, redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
